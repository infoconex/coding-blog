---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Coding',
  description = 'Software engineering, architecture, systems, and lessons accumulated the hard way.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #0d1117;
        color: #e6edf3;
      }
      * { box-sizing: border-box; }
      html { background: #0d1117; }
      body {
        margin: 0;
        min-height: 100vh;
        background:
          linear-gradient(#1d26311f 1px, transparent 1px),
          linear-gradient(90deg, #1d26311f 1px, transparent 1px),
          #0d1117;
        background-size: 40px 40px;
      }
      a { color: inherit; }
      .shell { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 76px;
        border-bottom: 1px solid #263240;
        background: #0d1117e8;
        backdrop-filter: blur(16px);
      }
      .brand {
        text-decoration: none;
        font: 800 24px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: -.05em;
      }
      .brand span { color: #38bdf8; }
      .nav { display: flex; gap: 24px; align-items: center; }
      .nav a {
        text-decoration: none;
        color: #9fb0c2;
        font: 700 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: .1em;
        text-transform: uppercase;
      }
      .nav a:hover { color: #e6edf3; }
      main { min-height: calc(100vh - 150px); }
      footer {
        border-top: 1px solid #263240;
        padding: 28px 0 46px;
        color: #71869a;
        font: 11px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      @media (max-width: 720px) {
        .nav a:not(:last-child) { display: none; }
      }
    </style>
  </head>
  <body>
    <header class="site-header shell">
      <a class="brand" href={`${base}/`}>CODING<span>/</span></a>
      <nav class="nav" aria-label="Primary navigation">
        <a href={`${base}/writing/`}>Writing</a>
        <a href={`${base}/archive/`}>Archive</a>
        <a href={`${base}/about/`}>About</a>
        <a href={`${base}/prototypes/theme-picker/`}>Themes</a>
      </nav>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="shell">© 2008–{new Date().getFullYear()} Jim Scott · Coding</footer>
  </body>
</html>
